# ~/.bashrc: executed by bash(1) for non-login shells.

# If not running interactively, don't do anything
# (prevents issues when sourced by non-interactive shells like scp, rsync, etc.)
case $- in
    *i*) ;;
      *) return;;
esac

# ---------------------------------------------------------------------------
# Shell options
# ---------------------------------------------------------------------------
shopt -s checkwinsize

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
# eza (modern ls with icons and git integration)
alias ls='eza --icons'
alias ll='eza -lag --icons --git'
alias la='eza -a --icons'
alias l='eza --icons'
alias lt='eza --tree --icons --level=2'
alias llt='eza -lag --tree --icons --level=2 --git'
# bat (cat with syntax highlighting; Debian package name is 'bat')
alias cat='batcat --paging=never'
alias catp='batcat'
alias less='batcat'
# grep
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# ---------------------------------------------------------------------------
# Fzf (fuzzy finder: Ctrl+R for history, Ctrl+T for files)
# ---------------------------------------------------------------------------
eval "$(fzf --bash)"

# ---------------------------------------------------------------------------
# Prompt (starship)
# ---------------------------------------------------------------------------
eval "$(starship init bash)"

# ---------------------------------------------------------------------------
# Profile environment (PATH, env vars added by profile setup scripts).
# Profiles MUST write here instead of .bashrc — see profiles/README.md
# ---------------------------------------------------------------------------
[ -f ~/.bashrc_profile ] && . ~/.bashrc_profile

# ---------------------------------------------------------------------------
# Zoxide (smarter cd) — must come after starship
# see https://github.com/ajeetdsouza/zoxide#installation
#
# Default commands (no --cmd override):
#   z  → smart jump (learns directories you visit)
#   zi → interactive selection with fzf
#
# _ZO_DOCTOR=0 — VSCode's terminal shell integration appends its own hook to
# PROMPT_COMMAND after .bashrc finishes, which triggers a false-positive
# warning from zoxide's doctor check.  Zoxide still works correctly.
# ---------------------------------------------------------------------------
export _ZO_DOCTOR=0
eval "$(zoxide init bash)"

# ---------------------------------------------------------------------------
# History — unlimited, ISO timestamps, multi-terminal sync
# MUST be last: _pc_add hooks go after starship and zoxide in PROMPT_COMMAND
# ---------------------------------------------------------------------------
HISTSIZE=
HISTFILESIZE=
HISTTIMEFORMAT="%F %T -> "
HISTCONTROL=ignoreboth
shopt -s histappend

_pc_add() {
	if [[ -n "$PROMPT_COMMAND" ]]; then
		PROMPT_COMMAND="$PROMPT_COMMAND; $1"
	else
		PROMPT_COMMAND="$1"
	fi
}

# Sync: read new → write ours → clear → reload
_pc_add 'history -n'
_pc_add 'history -a'
_pc_add 'history -c'
_pc_add 'history -r'
